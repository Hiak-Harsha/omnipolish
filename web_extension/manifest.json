{
  "manifest_version": 3,
  "name": "OmniPolish - AI Text Polisher",
  "version": "1.0.0",
  "description": "Autocorrects, structures, and highlights key points in any text field across WhatsApp Web, ChatGPT, Gmail, and more.",
  "permissions": ["activeTab", "storage"],
  "host_permissions": [
    "http://127.0.0.1:8765/*",
    "http://localhost:8765/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "OmniPolish Settings"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}